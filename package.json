{
  "name": "threebody-space",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/sync-data.mjs && vite",
    "build": "node scripts/sync-data.mjs && vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "images": "node scripts/optimize-images.mjs",
    "sentences": "node scripts/build-sentences.mjs --offline && node scripts/sync-data.mjs",
    "build:standalone": "npm run build && vite build --config vite.standalone.config.ts",
    "serve": "node scripts/serve.mjs"
  },
  "dependencies": {
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "typescript": "~5.7.3",
    "vite": "^6.0.11",
    "vue-tsc": "^2.2.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
